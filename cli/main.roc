# The `android.roc` tool: create, build and run a roc-native-android app.
# Each release bundles this package with the Kotlin shell's classes.dex and
# its platform's URL (`Bundle.roc`, generated by scripts/release.roc), and
# publishes a small `android.roc` app that runs it.
package
	[Android]
	{
		cli: platform "https://github.com/roc-lang/basic-cli/releases/download/0.28.1/7brgwR8YUqfeGrkdfF1V4GPPN7DnP7ftqub9KcrTEZtr.tar.zst",
	}
