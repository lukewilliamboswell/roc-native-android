<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- HTTP (FX kind 1). Cleartext stays off: the http example uses https. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Connectivity facts (boot section 3, FX 6). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- One launcher entry per example, each in its own process: a Roc
         library holds one engine, and every app exports the same JNI names. -->
    <application android:label="Roc Android" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".CounterActivity" android:label="Roc Counter" android:process=":counter" android:taskAffinity="dev.roc.android.counter" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TodosActivity" android:label="Roc Todos" android:process=":todos" android:taskAffinity="dev.roc.android.todos" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".StopwatchActivity" android:label="Roc Stopwatch" android:process=":stopwatch" android:taskAffinity="dev.roc.android.stopwatch" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".HttpActivity" android:label="Roc HTTP" android:process=":http" android:taskAffinity="dev.roc.android.http" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DeviceActivity" android:label="Roc Device" android:process=":device" android:taskAffinity="dev.roc.android.device" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
