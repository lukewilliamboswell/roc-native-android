## The pure decisions of the release script: its options, the tool
## package's generated `Bundle.roc`, its files and the `android.roc` launcher.
Release := [].{

	## The version, and where the release's assets will be served.
	options : List(Str) -> Try({ version : Str, base_url : Str }, [Usage])
	options = |args|
		match args.drop_if(|arg| arg == "--") {
			[version] if !version.starts_with("-") => Ok({ version, base_url: "https://github.com/lukewilliamboswell/roc-native-android/releases/download/${version}" })
			[version, "--base-url", url] if !version.starts_with("-") => Ok({ version, base_url: url.drop_suffix("/") })
			_ => Err(Usage)
		}

	## The tool's `Bundle.roc` for a release: what this copy of the tool
	## ships with.
	bundle_module : { version : Str, platform_url : Str, roc_version : Str } -> Str
	bundle_module = |{ version, platform_url, roc_version }|
		\\# Generated by scripts/release.roc for roc-native-android ${version}.
		\\import "scaffold-main.txt" as scaffold_main_text : Str
		\\import "shell.dex" as shell_dex_bytes : List(U8)
		\\
		\\## What this copy of the tool ships with: its release, that release's
		\\## platform, the Roc it was tested with, the app `init` writes and the
		\\## platform's Kotlin shell.
		\\Bundle := [].{
		\\	version = "${version}"
		\\	platform_url = "${platform_url}"
		\\	roc_version = "${roc_version}"
		\\
		\\	## The counter `init` writes as `main.roc`.
		\\	scaffold_main : Str
		\\	scaffold_main = scaffold_main_text
		\\
		\\	## The Kotlin shell, packaged as each app's `classes.dex`.
		\\	shell_dex : List(U8)
		\\	shell_dex = shell_dex_bytes
		\\}
		\\

	## The files `roc bundle` packs for the tool: the package root first,
	## then its modules, the files `Bundle.roc` imports and the notices.
	tool_files : List(Str) -> List(Str)
	tool_files = |modules|
		["main.roc"]
			.concat(modules.drop_if(|name| name == "main.roc"))
			.concat(["Bundle.roc", "scaffold-main.txt", "shell.dex", "LICENSE", "THIRD_PARTY_LICENSES.md"])

	## The `android.roc` an author downloads.
	launcher : { version : Str, tool_url : Str } -> Str
	launcher = |{ version, tool_url }|
		\\# android.roc, from roc-native-android ${version}: create, build and run a
		\\# roc-native-android app. Keep it beside the app's main.roc and run it
		\\# with Roc:
		\\#
		\\#     roc android.roc init my-app    create an app in my-app/
		\\#     roc android.roc run            build it, install it and start it
		\\#     roc android.roc build          build its APK
		\\#
		\\# To move to another release, download that release's android.roc over
		\\# this one and change the platform in main.roc to match.
		\\app [main!] {
		\\	cli: platform "https://github.com/roc-lang/basic-cli/releases/download/0.28.1/7brgwR8YUqfeGrkdfF1V4GPPN7DnP7ftqub9KcrTEZtr.tar.zst",
		\\	android: "${tool_url}",
		\\}
		\\
		\\import android.Android
		\\
		\\main! = |args| Android.run!(args)
		\\
}

expect Release.options(["0.0.1"]) == Ok({ version: "0.0.1", base_url: "https://github.com/lukewilliamboswell/roc-native-android/releases/download/0.0.1" })
expect Release.options(["--", "0.0.1", "--base-url", "http://localhost:8787/"]) == Ok({ version: "0.0.1", base_url: "http://localhost:8787" })
expect Release.options([]) == Err(Usage)

expect Release.tool_files(["Android.roc", "main.roc"]) == ["main.roc", "Android.roc", "Bundle.roc", "scaffold-main.txt", "shell.dex", "LICENSE", "THIRD_PARTY_LICENSES.md"]

expect Release.bundle_module({ version: "0.0.1", platform_url: "u", roc_version: "r" }).contains("\tplatform_url = \"u\"\n")
expect Release.launcher({ version: "0.0.1", tool_url: "t" }).contains("\tandroid: \"t\",\n")
